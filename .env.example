# ---------------------------------------------------------------------------
# Cold Email Command Center — environment variables
# Copy this file to `.env` (local dev) and/or set these in Netlify > Site
# settings > Environment variables (production).
# ---------------------------------------------------------------------------

# --- Supabase (frontend) -----------------------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=
# Public anon key (safe to expose to the browser). Found under
# Supabase > Project settings > API > Project API keys > anon public.
VITE_SUPABASE_ANON_KEY=

# If BOTH of the above are blank, the app automatically runs in "Local mode"
# and stores everything in your browser (localStorage), pre-seeded with demo
# data. Useful for trying it out before wiring up Supabase.

# --- Netlify Functions (server-side only — never exposed to the browser) -----
# Anthropic (Claude) key used by the AI cold-email sequence generator.
ANTHROPIC_API_KEY=
# Optional: the Claude model (defaults to claude-opus-4-8). Cheaper/faster
# options: claude-sonnet-4-6, claude-haiku-4-5.
ANTHROPIC_MODEL=claude-opus-4-8
# Instantly.ai API v2 key (read scopes: all:read OR campaigns:read accounts:read
# analytics:read leads:read). Powers the live Instantly insights page.
INSTANTLY_API_KEY=
# OpenAI key used by the optional AI lead-enrichment function.
OPENAI_API_KEY=
# Optional: the model used for enrichment (defaults to gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini
# Optional shared secret. If set, the serverless functions require callers to
# send this value in the `x-app-token` header. Set the SAME value as
# VITE_APP_TOKEN so the frontend can attach it. Recommended because the app
# itself has no login.
APP_FUNCTION_TOKEN=
VITE_APP_TOKEN=

# --- Login gate (optional) ---------------------------------------------------
# If VITE_APP_PASSWORD is set, the app shows a username/password screen.
# Leave blank for an open app. (Client-side gate — for hard protection use
# Netlify's built-in site password or Supabase Auth.)
VITE_APP_USERNAME=
VITE_APP_PASSWORD=
